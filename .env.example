# Configurar como variáveis de ambiente na Netlify (Site settings → Environment
# variables), nunca commitar valores reais.

# Credencial de serviço do Firebase (Project Settings → Service accounts →
# Generate new private key). Copie os 3 campos abaixo do JSON baixado.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Mantenha as quebras de linha como \n literais (uma linha só):
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
