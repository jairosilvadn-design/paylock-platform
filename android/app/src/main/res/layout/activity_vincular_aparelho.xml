<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Quase lá!"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Digite o código do cliente (o mesmo IMEI usado no cadastro do painel) para vincular este aparelho."
        android:textSize="14sp"
        android:layout_marginBottom="24dp" />

    <EditText
        android:id="@+id/etImei"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Código do cliente / IMEI"
        android:inputType="text"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnVincular"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Vincular aparelho" />

</LinearLayout>
