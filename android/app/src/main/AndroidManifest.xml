<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:allowBackup="false"
        android:label="PayLock"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.PayLock">

        <!-- Tela principal: status do financiamento (visível fora do kiosk também) -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Tela exibida em modo Kiosk: chave PIX, valor, botão copiar -->
        <activity
            android:name=".PixPaymentActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask" />

        <!-- Tela de aceite do Termo de Adesão: ponto único onde "pessoa aceita
             -> sistema executa" acontece (Device Owner completo ou só Admin
             de Dispositivo, dependendo de como o app foi instalado). -->
        <activity
            android:name=".TermsActivity"
            android:exported="false" />

        <!-- Recebida durante o provisionamento Android Enterprise (QR Code /
             afw#setup) para configurar o Device Owner. -->
        <receiver
            android:name=".PayLockDeviceAdminReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_policies" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
                <action android:name="android.app.action.PROFILE_PROVISIONING_COMPLETE" />
                <action android:name="android.app.action.DEVICE_ADMIN_DISABLE_REQUESTED" />
            </intent-filter>
        </receiver>

        <!-- Recebe os comandos BLOQUEAR/DESBLOQUEAR do backend via FCM -->
        <service
            android:name=".PayLockMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Reaplica o kiosk após reboot, se o aparelho estiver bloqueado -->
        <receiver
            android:name=".BootCompletedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
