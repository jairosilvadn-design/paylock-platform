rules_version = '2';

// Modelo mínimo: qualquer usuário autenticado no Firebase Auth que NÃO seja
// anônimo é um lojista/admin (ajuste para um claim de papel/loja se tiver
// múltiplas lojas). O app Android NÃO loga como lojista: ele se autentica
// de forma anônima (signInAnonymously) e só consegue criar/atualizar o
// próprio registro, com um conjunto bem restrito de campos.
service cloud.firestore {
  match /databases/{database}/documents {

    function isLojista() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isAparelhoAnonimo() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    match /clientes/{deviceId} {
      allow read, write: if isLojista();

      // Auto-registro: o próprio app cria o registro, uma única vez, como
      // "aguardando configuração" — o lojista completa o resto depois. Só
      // aceita os campos abaixo, e só quando o documento ainda não existe.
      allow create: if isAparelhoAnonimo()
        && !exists(/databases/$(database)/documents/clientes/$(deviceId))
        && request.resource.data.status == 'PENDENTE_CONFIGURACAO'
        && request.resource.data.keys().hasOnly(['status', 'termo', 'criadoEm']);
    }

    match /dispositivos/{deviceId} {
      allow read, write: if isLojista();

      // O aparelho (autenticado anonimamente) só consegue ler/gravar o
      // próprio documento, e apenas os campos operacionais — nunca dados de
      // outros clientes.
      allow get: if isAparelhoAnonimo();
      allow create, update: if isAparelhoAnonimo()
        && request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys()
             .hasOnly(['deviceId', 'fcmToken', 'kioskAtivo', 'ultimaSincronizacaoEm', 'versaoApp']);
    }
  }
}
